# =============================================================================
# Semantic RAG Knowledge Base & Interactive Topic Graph — Environment Template
# Copy this file to `.env` and replace placeholder values before deployment.
# =============================================================================

# --- Web Application Authentication & Security ---
KB_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
KB_SESSION_SECRET=CHANGE_ME_SESSION_SECRET_KEY
KB_PORT=8080

# --- Portable Data Paths (Defaults to ./data/* inside the repository) ---
KB_DATA_DIR=./data
KB_DB_PATH=./data/knowledge_base.db
KB_INGEST_DIR=./data/ingest
KB_UPLOADS_DIR=./data/uploads

# --- Optional External LLM Providers (Falls back to Local Hybrid RAG if blank) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Optional Cloudflare Edge Deployment (Workers + D1 + Vectorize + Workers AI) ---
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN
CLOUDFLARE_WORKER_NAME=archive-rag-kb
CLOUDFLARE_D1_NAME=archive-knowledge-db
CLOUDFLARE_VECTORIZE_INDEX=archive-kb-index
